# Токен авторизации hh.ru (получите на dev.hh.ru)
HH_ACCESS_TOKEN=your_hh_access_token_here

# Идентификатор и Секрет вашего OAuth-приложения на dev.hh.ru
HH_CLIENT_ID=your_client_id_here
HH_CLIENT_SECRET=your_client_secret_here

# ID вашего резюме на hh.ru (можно получить через GET /me или в URL резюме на сайте)
HH_RESUME_ID=your_resume_id_here

# API ключ Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Поисковые запросы через запятую
SEARCH_QUERIES=Python developer,AI Developer,LLM Engineer

# Регион поиска (113 - Россия, 1 - Москва, 2 - Санкт-Петербург, 72 - Пермь)
SEARCH_AREA=113

# Порог совпадения в % (от 0 до 100), при котором отправляется отклик
MATCH_THRESHOLD=75

# Безопасный режим (True - только анализ и генерация писем без реальной отправки откликов)
DRY_RUN=True
